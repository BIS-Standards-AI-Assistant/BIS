# Copy to .env before `docker compose up`.

# Long random string — this is what protects the Ollama endpoint from
# anonymous internet access. Generate one with: openssl rand -hex 32
OLLAMA_TOKEN=

# A real domain/subdomain pointed at this VM's IP gets automatic HTTPS
# (recommended for anything beyond a quick demo). Leave unset to serve
# plain HTTP on :11434 instead.
#   OLLAMA_DOMAIN=ollama.yourdomain.com
OLLAMA_DOMAIN=
