# Copy to .env.local and fill in what you have. Nothing here is required —
# see docs/ARCHITECTURE.md: paid LLM inference is optional and is not a
# dependency of the BIS intelligence engine. With zero LLM env vars set,
# the app still works: intent extraction and answer generation fall back to
# deterministic behavior (see src/lib/intent.ts, src/lib/answer.ts).

# --- Database (required for retrieval/ingestion) ---
DATABASE_URL=

# --- LLM provider routing ---
# auto (default) = try local -> openrouter-free -> paid, in that order.
# Or pin to exactly one: local | openrouter-free | paid | none
LLM_PROVIDER=auto

# --- Local provider (Ollama or any OpenAI-compatible /chat/completions server) ---
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Only set this to true if you've verified your local model/server actually
# returns valid JSON reliably for structured extraction. Defaults to false.
LOCAL_LLM_SUPPORTS_STRUCTURED_OUTPUT=

# --- OpenRouter (free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Paid provider (optional, same OpenRouter-compatible interface, different credentials/model) ---
PAID_PROVIDER_API_KEY=
PAID_PROVIDER_MODEL=
