# Copy to .env.local and fill in what you have. Nothing here is required —
# see docs/ARCHITECTURE.md: paid LLM inference is optional and is not a
# dependency of the BIS intelligence engine. With zero LLM env vars set,
# the app still works: intent extraction and answer generation fall back to
# deterministic behavior (see src/lib/intent.ts, src/lib/answer.ts).

# --- Database (required for retrieval/ingestion) ---
DATABASE_URL=

# --- LLM provider routing ---
# auto (default) = try local -> openrouter-free -> paid, in that order.
# Or pin to exactly one: local | openrouter-free | paid | none
LLM_PROVIDER=auto

# --- Local provider (Ollama or any OpenAI-compatible /chat/completions server) ---
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Only set this to true if you've verified your local model/server actually
# returns valid JSON reliably for structured extraction. Defaults to false.
LOCAL_LLM_SUPPORTS_STRUCTURED_OUTPUT=

# --- OpenRouter (free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Paid provider (optional, same OpenRouter-compatible interface, different credentials/model) ---
PAID_PROVIDER_API_KEY=
PAID_PROVIDER_MODEL=

# --- Speech-to-text (optional; server-side fallback for voice input) ---
# Voice input uses the browser's Web Speech API when it works. Chromium
# builds without Google's speech API key (Brave, Arc, plain Chromium) and
# Firefox have no working Web Speech API — for those, the app falls back to
# POST /api/v1/transcribe, which needs the settings below. Leave unset and
# voice input simply stays unavailable in those browsers (stated honestly
# in the UI), while Chrome/Edge keep working.
#
# Any OpenAI-compatible /audio/transcriptions endpoint works. Groq is the
# recommended default: free tier, very low latency, strong Indian-language
# coverage. Get a key at https://console.groq.com/keys
#   STT_BASE_URL=https://api.groq.com/openai/v1
#   STT_MODEL=whisper-large-v3-turbo
# OpenAI alternative:
#   STT_BASE_URL=https://api.openai.com/v1
#   STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# Throttle for POST /api/v1/transcribe, which is public and costs money per
# call. Defaults to 15 requests per minute per client IP — generous for a
# person using voice search, tight enough that a script can't drain the STT
# quota. In-memory and process-local: with multiple replicas the effective
# limit is (replicas x limit). See src/lib/rate-limit.ts.
TRANSCRIBE_RATE_LIMIT=15
TRANSCRIBE_RATE_WINDOW_MS=60000
