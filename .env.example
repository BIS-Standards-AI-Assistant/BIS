# Copy to .env.local and fill in what you have. Nothing here is required —
# see docs/ARCHITECTURE.md: paid LLM inference is optional and is not a
# dependency of the BIS intelligence engine. With zero LLM env vars set,
# the app still works: intent extraction and answer generation fall back to
# deterministic behavior (see src/lib/intent.ts, src/lib/answer.ts).

# --- Database (required for retrieval/ingestion) ---
DATABASE_URL=

# --- LLM provider routing ---
# auto (default) = try each configured provider in order:
#   groq -> gemini -> local -> openrouter-free -> paid, then evidence-only.
# Or pin to exactly one: groq | gemini | local | openrouter-free | paid | none
# "none" forces evidence-only (deterministic) behavior everywhere.
LLM_PROVIDER=auto

# --- Local provider: Ollama, LM Studio, vLLM, or any OpenAI-compatible server ---
# For Ollama, the base URL is the OpenAI-compat root and MUST end in /v1.
#   Host install:   http://localhost:11434/v1
#   Docker (local profile): http://ollama:11434/v1   (set in docker-compose.yml)
# Install Ollama (https://ollama.com), then before first use:
#   ollama pull llama3.2:3b
# Verify the full round trip any time with:  npm run ollama:smoke
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.2:3b
# Only needed when LOCAL_LLM_BASE_URL points at a remote Ollama (e.g. a
# separate VM, not the same machine/Docker network as the app) sitting
# behind a reverse proxy that checks this token — see deploy/ollama-vm/.
# Sent as `Authorization: Bearer <key>`. Leave unset for a local/same-network
# Ollama, which has no auth of its own and needs none.
LOCAL_LLM_API_KEY=
# Request timeout for the local server, in ms. Default 15000. Raise it only
# if your hardware genuinely needs longer for a full answer generation —
# this is a knob, not a fix for a wrong model choice.
LOCAL_LLM_TIMEOUT_MS=
# Only set this to true if you've verified YOUR model/server actually returns
# valid, schema-conformant JSON reliably for structured extraction (intent +
# answer). Defaults to false — when false, the router simply skips the local
# provider for structured calls and the deterministic path handles them.
# llama3.2:3b passed a trivial-schema smoke but is NOT verified for the real
# intent/answer schemas — leave this unset for that model.
LOCAL_LLM_SUPPORTS_STRUCTURED_OUTPUT=

# --- OpenRouter (free tier) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Paid provider (optional, same OpenRouter-compatible interface, different credentials/model) ---
PAID_PROVIDER_API_KEY=
PAID_PROVIDER_MODEL=

# --- Speech-to-text (optional; server-side fallback for voice input) ---
# Voice input uses the browser's Web Speech API when it works. Chromium
# builds without Google's speech API key (Brave, Arc, plain Chromium) and
# Firefox have no working Web Speech API — for those, the app falls back to
# POST /api/v1/transcribe, which needs the settings below. Leave unset and
# voice input simply stays unavailable in those browsers (stated honestly
# in the UI), while Chrome/Edge keep working.
#
# Any OpenAI-compatible /audio/transcriptions endpoint works. Groq is the
# recommended default: free tier, very low latency, strong Indian-language
# coverage. Get a key at https://console.groq.com/keys
#   STT_BASE_URL=https://api.groq.com/openai/v1
#   STT_MODEL=whisper-large-v3-turbo
# OpenAI alternative:
#   STT_BASE_URL=https://api.openai.com/v1
#   STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# Throttle for POST /api/v1/transcribe, which is public and costs money per
# call. Defaults to 15 requests per minute per client IP — generous for a
# person using voice search, tight enough that a script can't drain the STT
# quota. In-memory and process-local: with multiple replicas the effective
# limit is (replicas x limit). See src/lib/rate-limit.ts.
TRANSCRIBE_RATE_LIMIT=15
TRANSCRIBE_RATE_WINDOW_MS=60000

# --- Text-to-speech (optional; read-aloud for generated answers) ---
# Synthesis runs SERVER-side (POST /api/v1/speak) so the browser fetches a
# small audio file rather than downloading a model per visitor. Leave unset
# and read-aloud falls back to the browser's own speechSynthesis, which
# needs no server but has no Hindi voice on many devices.
#
# Google Cloud Text-to-Speech, chosen for a recurring monthly free tier on
# Standard voices (not trial credit) plus real Hindi. Create an API key at
# https://console.cloud.google.com/apis/credentials with the
# Cloud Text-to-Speech API enabled. Restrict the key to that API.
TTS_API_KEY=

# Throttle for the public, quota-consuming /api/v1/speak endpoint.
# Identical answers are cached in memory, so repeats cost nothing.
SPEAK_RATE_LIMIT=20
SPEAK_RATE_WINDOW_MS=60000
