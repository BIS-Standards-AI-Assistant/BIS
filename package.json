{
  "name": "bis-standards-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "ingest": "dotenv -e .env.local -- tsx scripts/ingest.ts",
    "test:ml": "tsx scripts/test-query-normalization.ts && tsx scripts/test-evidence-aggregation.ts && tsx scripts/test-grounding-pipeline.ts && tsx scripts/test-answer-schema-validation.ts",
    "test:unit": "vitest run",
    "test": "npm run test:ml && npm run test:unit",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:reranker": "dotenv -e .env.local -- tsx scripts/eval-reranker.ts",
    "eval:generation": "tsx scripts/eval-generation.ts",
    "eval:validate": "dotenv -e .env.local -- tsx scripts/validate-generation.ts",
    "eval:calibration": "tsx scripts/calibrate-confidence.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "data:discover": "tsx scripts/data-discover.ts",
    "data:migrate-existing": "dotenv -e .env.local -- tsx scripts/data-migrate-existing.ts",
    "data:report": "dotenv -e .env.local -- tsx scripts/data-report.ts",
    "tools:smoke": "dotenv -e .env.local -- tsx scripts/tools-smoke.ts",
    "agent:smoke": "dotenv -e .env.local -- tsx scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.86",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.83",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "pdf-parse": "^1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
